---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Medical Professionals | AC-130 Viper" description="Product-development information for medical and technical professionals following the AC-130 Viper program.">
  <main>
    <section class="sub-hero">
      <div class="container">
        <p class="eyebrow">04 / MEDICAL PROFESSIONALS</p>
        <h1>Information for professionals.</h1>
        <p>Nonpromotional updates for healthcare, engineering, manufacturing, quality and business professionals.</p>
      </div>
    </section>

    <section class="content-section"><div class="container prose-narrow"><h2>Professional inquiries</h2><p>New York Cryogen welcomes general professional inquiries about the AC-130 Viper development program. The device remains under development and is not available for commercial distribution in the United States.</p><p>This page does not offer clinical training, device purchasing, commercial-use commitments, treatment reservations or medical advice.</p><p>Future product information, labeling and intended uses will depend on completed development and applicable regulatory review.</p><a class="button-primary" href="/contact/">Send a business inquiry ↗</a></div></section>

    <section class="sub-cta">
      <div class="container">
        <p class="eyebrow">STAY CONNECTED</p>
        <h2>Follow the development of AC-130 Viper.</h2>
        <p>For product-development, company, business or media inquiries, contact New York Cryogen.</p>
        <a class="button-primary" href="/contact/">Contact New York Cryogen ↗</a>
      </div>
    </section>
  </main>
</BaseLayout>
