---
import BaseLayout from '../../layouts/BaseLayout.astro';
const episodes = ['1Akb2MQvSbepkOrrXtOMjJ','1PzArAbe4lZpLGmTTCJsci','2Y2YXNsJALZcizPfI8VLjQ','0XWxZazmlzFCqzYfTK4LN9'];
---
<BaseLayout title="Podcasts & Media | AC-130 Viper" description="Listen to interviews and podcasts featuring New York Cryogen founder Gregory Papageorge.">
<main><section class="sub-hero"><div class="container"><p class="eyebrow">05 / MEDIA</p><h1>Podcasts & interviews.</h1><p>Explore conversations about New York Cryogen and its product-development journey.</p></div></section>
    <section class="content-section light-section"><div class="container"><p class="eyebrow">SPOTIFY EPISODES</p><h2>Listen to the conversations</h2><p>Interviews featuring Gregory Papageorge. Titles and external content are controlled by their publishers.</p><div class="podcast-grid">{episodes.map((id, index) => <article class="podcast-card"><div class="podcast-card-content"><p class="podcast-kicker">EPISODE {String(index+1).padStart(2,'0')}</p><div class="spotify-frame"><iframe title={`Spotify podcast episode ${index+1}`} src={`https://open.spotify.com/embed/episode/${id}`} width="100%" height="152" loading="lazy" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" style="border:0;"></iframe></div><a href={`https://open.spotify.com/episode/${id}`} target="_blank" rel="noopener noreferrer">Listen on Spotify ↗</a></div></article>)}</div></div></section>
    <section class="content-section"><div class="container split-layout"><figure class="content-image"><img src="/podcast/gregory-interview-poster.jpg" alt="Gregory Papageorge interview video thumbnail" width="960" height="540" loading="lazy"/></figure><div><p class="eyebrow">VIDEO INTERVIEW</p><h2>Gregory Papageorge — New York Cryogen</h2><p>The full-length interview is available as an original video file. Hosting and a streaming embed will be added once a suitable publisher URL has been confirmed.</p><p class="editorial-note">Interviews represent speakers’ views, not proof of regulatory authorization or clinical effectiveness.</p></div></div></section><section class="sub-cta"><div class="container"><h2>Have a media inquiry?</h2><a class="button-primary" href="/contact/">Contact us ↗</a></div></section></main></BaseLayout>