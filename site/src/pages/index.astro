
---
import "../styles/global.css";
import "../styles/home.css";

const title = "AC-130 Viper | Medical Cooling Technology in Development";
const description =
  "Explore the AC-130 Viper, a localized CO₂ cooling technology platform under development by New York Cryogen, Inc.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, follow" />
    <meta name="theme-color" content="#071426" />

    <!-- Social sharing metadata -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
  </head>

  <body>
    <!-- Header -->
    <header class="header">
      <div class="container nav">
        <a
          href="/"
          class="brand"
          aria-label="AC-130 Viper home"
        >
          <span class="brand-icon" aria-hidden="true">V</span>
          <span>AC-130 <strong>VIPER</strong></span>
        </a>

        <nav class="desktop-nav" aria-label="Main navigation">
          <a href="#technology">Technology</a>
          <a href="#development">Development</a>
          <a href="#about">About</a>
          <a href="#contact">Contact</a>
        </nav>

        <a class="nav-cta" href="#contact">
          Get Updates <span aria-hidden="true">↗</span>
        </a>

        <details class="mobile-menu">
          <summary aria-label="Open navigation menu">
            ☰
          </summary>

          <nav aria-label="Mobile navigation">
            <a href="#technology">Technology</a>
            <a href="#development">Development</a>
            <a href="#about">About</a>
            <a href="#contact">Contact</a>
          </nav>
        </details>
      </div>
    </header>

    <main>
      <!-- Hero -->
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-glow" aria-hidden="true"></div>

        <div class="container hero-grid">
          <div class="hero-copy">
            <div class="eyebrow">
              <span class="status-dot" aria-hidden="true"></span>
              MEDICAL TECHNOLOGY IN DEVELOPMENT
            </div>

            <h1 id="hero-title">
              Precision Engineered.
              <span>Driven by Innovation.</span>
            </h1>

            <p class="hero-description">
              Introducing the AC-130 Viper, a localized CO₂ cooling
              technology platform under development by New York Cryogen, Inc.
            </p>

            <div class="hero-actions">
              <a href="#technology" class="button-primary">
                Explore Our Technology
                <span aria-hidden="true">↗</span>
              </a>

              <a href="#development" class="button-secondary">
                Development Status
                <span aria-hidden="true">→</span>
              </a>
            </div>

            <div class="hero-note">
              <span class="note-icon" aria-hidden="true">i</span>

              <p>
                The AC-130 Viper is under development and is not
                available for commercial distribution in the
                United States.
              </p>
            </div>
          </div>

          <!-- Abstract technology visual -->
          <div
            class="hero-visual"
            role="img"
            aria-label="Abstract AC-130 Viper technology-inspired graphic"
          >
            <div class="visual-grid"></div>
            <div class="orbital orbital-one"></div>
            <div class="orbital orbital-two"></div>

            <div class="core">
              <div class="core-inner">V</div>
            </div>

            <div class="visual-label label-top">
              <span class="mini-line"></span>
              AC-130 / VIPER
            </div>

            <div class="visual-label label-bottom">
              ENGINEERING IN PROGRESS
              <span class="mini-line"></span>
            </div>
          </div>
        </div>
      </section>

      <!-- Technology highlights -->
      <section class="strip" aria-label="Development focus">
        <div class="container strip-inner">
          <span>PRECISION ENGINEERING</span>
          <span class="strip-dot" aria-hidden="true">✦</span>
          <span>LOCALIZED CO₂ COOLING</span>
          <span class="strip-dot" aria-hidden="true">✦</span>
          <span>PRODUCT DEVELOPMENT</span>
        </div>
      </section>

      <!-- Technology -->
      <section
        id="technology"
        class="section"
        aria-labelledby="technology-title"
      >
        <div class="container">
          <div class="section-heading">
            <div class="eyebrow">
              01 / TECHNOLOGY OVERVIEW
            </div>

            <h2 id="technology-title">
              Engineering a new approach to
              <span>localized cooling technology.</span>
            </h2>

            <p>
              The AC-130 Viper development program explores the
              integration of mechanical engineering, localized CO₂
              delivery, and monitoring technology.
            </p>
          </div>

          <div class="cards">
            <article class="feature-card">
              <span class="feature-number">01</span>
              <div class="feature-symbol" aria-hidden="true">◎</div>

              <h3>Localized Cooling</h3>

              <p>
                A technology concept focused on localized CO₂ cooling,
                with final product configuration subject to development
                and review.
              </p>
            </article>

            <article class="feature-card">
              <span class="feature-number">02</span>
              <div class="feature-symbol" aria-hidden="true">⌁</div>

              <h3>Precision Engineering</h3>

              <p>
                Engineering development focused on system integration,
                design refinement, and product configuration.
              </p>
            </article>

            <article class="feature-card">
              <span class="feature-number">03</span>
              <div class="feature-symbol" aria-hidden="true">◈</div>

              <h3>Development &amp; Testing</h3>

              <p>
                Ongoing work includes engineering evaluation, testing,
                quality preparation, and regulatory activities.
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- Development Status -->
      <section
        id="development"
        class="section development"
        aria-labelledby="development-title"
      >
        <div class="container development-grid">
          <div>
            <div class="eyebrow">
              02 / DEVELOPMENT STATUS
            </div>

            <h2 id="development-title">
              Built on engineering.
              <span>Guided by development.</span>
            </h2>

            <p>
              New York Cryogen, Inc. continues work on the AC-130
              Viper technology platform. Final specifications,
              intended use, labeling, and availability remain
              subject to applicable regulatory review and may change.
            </p>

            <a href="#contact" class="text-link">
              Contact the development team
              <span aria-hidden="true">↗</span>
            </a>
          </div>

          <div class="status-panel">
            <div class="panel-heading">
              <span>PRODUCT STATUS</span>
              <span class="panel-indicator">
                ● IN DEVELOPMENT
              </span>
            </div>

            <div class="panel-content">
              <div class="status-line">
                <span>Technology</span>
                <strong>Localized CO₂ Cooling</strong>
              </div>

              <div class="status-line">
                <span>Developer</span>
                <strong>New York Cryogen, Inc.</strong>
              </div>

              <div class="status-line">
                <span>Development</span>
                <strong>Ongoing</strong>
              </div>

              <div class="status-line">
                <span>US Commercial Availability</span>
                <strong>Not Available</strong>
              </div>
            </div>

            <p class="panel-footnote">
              This is nonpromotional product-development information,
              not an offer to purchase or schedule treatment.
            </p>
          </div>
        </div>
      </section>

      <!-- About -->
      <section
        id="about"
        class="section about"
        aria-labelledby="about-title"
      >
        <div class="container">
          <div class="eyebrow">
            03 / THE COMPANY
          </div>

          <h2 id="about-title">
            Innovation through
            <span>purposeful engineering.</span>
          </h2>

          <p>
            New York Cryogen, Inc. is developing the AC-130 Viper.
            The company is focused on product engineering, testing,
            quality preparation, and regulatory work as its
            technology evolves.
          </p>
        </div>
      </section>

      <!-- Contact -->
      <section
        id="contact"
        class="section contact"
        aria-labelledby="contact-title"
      >
        <div class="container contact-content">
          <div class="eyebrow">
            04 / STAY CONNECTED
          </div>

          <h2 id="contact-title">
            Follow the future of
            <span>AC-130 Viper.</span>
          </h2>

          <p>
            Connect with New York Cryogen for company, engineering,
            business, media, or general product-development inquiries.
          </p>

          <a
            class="button-primary"
            href="mailto:bill@nycryogen.com?subject=AC-130%20Viper%20Development%20Inquiry"
          >
            Contact Our Team
            <span aria-hidden="true">↗</span>
          </a>

          <small>
            Do not submit medical records or sensitive health
            information. Inquiries do not reserve a product or
            schedule treatment.
          </small>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer>
      <div class="container footer-top">
        <a
          href="/"
          class="brand"
          aria-label="AC-130 Viper home"
        >
          <span class="brand-icon" aria-hidden="true">V</span>
          <span>AC-130 <strong>VIPER</strong></span>
        </a>

        <span>
          Technology development by New York Cryogen, Inc.
        </span>
      </div>

      <div class="container footer-bottom">
        <p>
          © {new Date().getFullYear()} New York Cryogen, Inc.
          All rights reserved.
        </p>

        <p>
          AC-130 Viper is under development and unavailable
          for commercial distribution in the United States.
        </p>
      </div>
    </footer>
  </body>
</html>
